<div {{ attributes }}>

    {# ─── BARRE DE FILTRES ─── #}
    <div class="filter-bar">
        
        {# Pills Disciplines #}
        <div class="flex flex-wrap items-center gap-1.5">
            {% set listDisciplines = ['Tous', 'Théâtre', 'Danse', 'Musique', 'Cirque'] %}
            {% for d in listDisciplines %}
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="discipline"
                        data-live-discipline-param="{{ d }}"
                        data-model="discipline"
                        value="{{ d }}"
                        class="filter-pill {{ discipline == d ? 'active' : '' }}">
                    {{ d }}
                </button>
            {% endfor %}
        </div>

        {# Outils : Recherche + Saison #}
        <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
            
            {# Partial Champ de Recherche #}
            {% include 'components/_search_bar.html.twig' with {
                placeholder: 'Titre du spectacle...'
            } %}

            {# Sélecteur de Saison #}
            <div class="flex items-center gap-1.5 text-xs text-slate-400 font-medium shrink-0">
                <span>Saison :</span>
                <select data-model="season" class="form-input-sm py-1 px-2 font-bold focus:outline-none">
                    <option value="2026-2027">2026-2027</option>
                    <option value="2025-2026">2025-2026</option>
                    <option value="2024-2025">2024-2025</option>
                </select>
            </div>

        </div>
    </div>

    {# Partial Loader AJAX #}
    {% include 'components/_search_loader.html.twig' with {
        label: 'Chargement des spectacles...'
    } %}

    {# ─── GRILLE DES SPECTACLES ─── #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for show in this.shows %}
            <div class="search-card flex flex-col justify-between group p-0 overflow-hidden">
                
                {# Image / Visual #}
                <div class="h-44 bg-slate-100 relative overflow-hidden shrink-0">
                    <span class="absolute top-3 left-3 z-10 bg-indigo-600/90 text-white text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md backdrop-blur-sm shadow-sm">
                        {{ show.discipline.value|default(show.discipline|default('Spectacle')) }}
                    </span>

                    {% if show.id and show.artworkUrl %}
                        <img src="{{ path('secure_show_image', {'id': show.id}) }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="{{ show.title }}">
                    {% else %}
                        <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-600">
                            <i class="fa-solid fa-masks-theater text-3xl opacity-30"></i>
                        </div>
                    {% endif %}
                </div>

                {# Infos Spectacle #}
                <div class="p-4 flex-grow flex flex-col justify-between gap-4">
                    <div>
                        <h3 class="font-bold text-slate-900 text-sm leading-tight group-hover:text-indigo-600 transition">
                            <a href="{{ path('show_show', {'id': show.id}) }}" class="after:absolute after:inset-0 focus:outline-none">
                                {{ show.title }}
                            </a>
                        </h3>
                        <p class="text-xs text-slate-400 font-medium mt-1">Compagnie de l'Instant Présent</p>
                    </div>

                    <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs text-slate-400 z-20 relative">
                        <span><i class="fa-regular fa-clock mr-1"></i> {{ show.DurationMin|default(60) }} min</span>
                        {% if is_granted('SHOW_EDIT', show) %}
                            <a href="{{ path('show_edit', {'id': show.id}) }}" class="p-1 px-2 text-amber-600 hover:bg-amber-50 rounded-md transition" title="Modifier">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>

            </div>
        {% else %}
            <div class="empty-results">
                <i class="fa-solid fa-folder-open text-2xl mb-2 block text-slate-300"></i>
                Aucun spectacle trouvé pour cette saison ou discipline.
            </div>
        {% endfor %}
    </div>

</div>