{% set activeFiltersCount = (this.discipline != 'Tous' ? 1 : 0) + (this.audience != 'Tous' ? 1 : 0) + (this.theme !=
'Tous' ? 1 : 0) %}

<div {{ attributes }} x-data="{ openFilters: false }">

    {# ─── BARRE DE FILTRES ET RECHERCHE ─── #}
    <div class="bg-white p-3 sm:p-4 rounded-xl border border-slate-100 shadow-sm mb-6">

        {# ─── VUE MOBILE : Recherche + Bouton Tiroir ─── #}
        <div class="flex items-center gap-2 sm:hidden">
            <div class="grow">
                {% include 'components/_search_bar.html.twig' with {
                placeholder: 'Titre du spectacle...'
                } %}
            </div>

            <button type="button" @click="openFilters = true"
                class="relative flex items-center gap-2 px-3.5 py-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-lg transition shrink-0">
                <i class="fa-solid fa-sliders"></i>
                <span>Filtres</span>
                {% if activeFiltersCount > 0 %}
                <span
                    class="w-4 h-4 bg-indigo-600 text-white text-[10px] rounded-full flex items-center justify-center font-bold ml-0.5">
                    {{ activeFiltersCount }}
                </span>
                {% endif %}
            </button>
        </div>

        {# ─── VUE DESKTOP : Filtres Alignés (Inline) ─── #}
        <div class="hidden sm:flex sm:flex-row items-center gap-3 w-full">

            {# Select Discipline #}
            <div class="w-52">
                <select data-model="discipline"
                    class="w-full form-input-sm py-2 px-3 text-xs font-medium bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                    <option value="Tous">Toutes les disciplines</option>
                    {% for d in this.disciplines %}
                    <option value="{{ d.value }}" {{ this.discipline==d.value ? 'selected' : '' }}>
                        {{ d.name|replace({'_': ' '})|capitalize }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            {# Select Audience #}
            <div class="w-52">
                <select data-model="audience"
                    class="w-full form-input-sm py-2 px-3 text-xs font-medium bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                    <option value="Tous">Type de public</option>
                    {% for a in this.audiences %}
                    <option value="{{ a.value }}" {{ this.audience==a.value ? 'selected' : '' }}>
                        {{ a.name|replace({'_': ' '})|capitalize }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            {# Select Thème #}
            <div class="w-52">
                <select data-model="theme"
                    class="w-full form-input-sm py-2 px-3 text-xs font-medium bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                    <option value="Tous">Tous les thèmes</option>
                    {% for t in this.themes %}
                    <option value="{{ t.id }}" {{ this.theme==t.id ? 'selected' : '' }}>
                        {{ t.name }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            {# Recherche Desktop #}
            <div class="filter-search-group grow">
                {% include 'components/_search_bar.html.twig' with {
                placeholder: 'Titre du spectacle...'
                } %}
            </div>

        </div>
    </div>

    {# ─── TIROIR DE FILTRES SLIDE-OVER (MOBILE) ─── #}
    <div x-show="openFilters" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs sm:hidden flex justify-end" style="display: none;">

        <div @click.away="openFilters = false" x-transition:enter="transition ease-out duration-300 transform"
            x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
            x-transition:leave="transition ease-in duration-200 transform" x-transition:leave-start="translate-x-0"
            x-transition:leave-end="translate-x-full"
            class="w-4/5 max-w-xs bg-white h-full p-5 flex flex-col justify-between shadow-2xl">

            <div class="space-y-5">
                {# En-tête du tiroir mobile #}
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-indigo-600"></i> Filtres
                        {% if activeFiltersCount > 0 %}
                        <span class="bg-indigo-100 text-indigo-700 text-[10px] font-bold px-2 py-0.5 rounded-full">
                            {{ activeFiltersCount }}
                        </span>
                        {% endif %}
                    </h3>
                    <button type="button" @click="openFilters = false" class="text-slate-400 hover:text-slate-600 p-1">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                {# Discipline #}
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5">Discipline</label>
                    <select data-model="discipline"
                        class="w-full py-2.5 px-3 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                        <option value="Tous">Toutes les disciplines</option>
                        {% for d in this.disciplines %}
                        <option value="{{ d.value }}" {{ this.discipline==d.value ? 'selected' : '' }}>
                            {{ d.name|replace({'_': ' '})|capitalize }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                {# Audience #}
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5">Public</label>
                    <select data-model="audience"
                        class="w-full py-2.5 px-3 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                        <option value="Tous">Type de public</option>
                        {% for a in this.audiences %}
                        <option value="{{ a.value }}" {{ this.audience==a.value ? 'selected' : '' }}>
                            {{ a.name|replace({'_': ' '})|capitalize }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                {# Thème #}
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5">Thème</label>
                    <select data-model="theme"
                        class="w-full py-2.5 px-3 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                        <option value="Tous">Tous les thèmes</option>
                        {% for t in this.themes %}
                        <option value="{{ t.id }}" {{ this.theme==t.id ? 'selected' : '' }}>
                            {{ t.name }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <button type="button" @click="openFilters = false"
                class="w-full bg-indigo-600 text-white font-semibold py-3 rounded-lg text-xs hover:bg-indigo-700 transition shadow-sm">
                Voir les résultats
            </button>
        </div>
    </div>

    {# Loader discret pendant la mise à jour des données Live #}
    {% include 'components/_search_loader.html.twig' with {
    label: 'Mise à jour des résultats...'
    } %}

    {# ─── GRILLE DES SPECTACLES ─── #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for show in this.shows %}
        <div
            class="search-card relative flex flex-col justify-between group p-0 overflow-hidden bg-white rounded-xl border border-slate-100 shadow-xs hover:shadow-md transition">

            {# Image / Tag #}
            <div class="h-44 bg-slate-100 relative overflow-hidden shrink-0">
                <span
                    class="absolute top-3 left-3 z-10 bg-indigo-600 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md shadow-sm">
                    {{ show.discipline.value|default(show.discipline) }}
                </span>

                {% if show.id and show.artworkUrl %}
                <img src="{{ path('secure_show_image', {'id': show.id}) }}"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    alt="{{ show.title }}">
                {% else %}
                <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-500">
                    <i class="fa-solid fa-masks-theater text-4xl opacity-40"></i>
                </div>
                {% endif %}
            </div>

            {# Contenu de la carte #}
            <div class="p-5 flex-grow flex flex-col justify-between gap-4">
                <div>
                    <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-indigo-600 transition">
                        {# Lien étendu sur l'ensemble de la carte #}
                        <a href="{{ path('show_show', {'id': show.id}) }}"
                            class="focus:outline-none after:absolute after:inset-0">
                            {{ show.title }}
                        </a>
                    </h3>
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs text-slate-400">
                    <span><i class="fa-regular fa-clock mr-1"></i> {{ show.durationMin|default(60) }} min</span>

                    {# ─── ACTIONS (ÉDITION & SUPPRESSION) ─── #}
                    <div class="relative z-10 flex items-center gap-1">
                        {# Modifier #}
                        {% if is_granted('SHOW_EDIT', show) %}
                        <a href="{{ path('show_edit', {'id': show.id}) }}"
                            class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition" title="Modifier">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                        {% endif %}

                        {# Supprimer #}
                        {% if is_granted('SHOW_DELETE', show) %}
                        <form method="post" action="{{ path('show_delete', {'id': show.id}) }}"
                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce spectacle ?');"
                            class="inline-block">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ show.id) }}">
                            <button type="submit"
                                class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition cursor-pointer"
                                title="Supprimer">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="empty-results col-span-full text-center py-12 bg-white rounded-xl border border-slate-100">
            <i class="fa-solid fa-folder-open text-3xl mb-2 block text-slate-300"></i>
            <span class="text-sm text-slate-500 font-medium">Aucun spectacle ne correspond à vos critères.</span>
        </div>
        {% endfor %}
    </div>
    {# ─── PAGINATION (UNIQUEMENT VUE DESKTOP : hidden sm:flex) ─── #}
    {% if this.totalItems > 0 %}
    <div
        class="hidden sm:flex flex-row items-center justify-between gap-4 mt-8 pt-4 border-t border-slate-200 text-xs text-slate-500">

        {# Compteur dynamique #}
        <p>
            Affichage de
            <span class="font-semibold text-slate-900">{{ this.pageStart }}-{{ this.pageEnd }}</span>
            sur
            <span class="font-semibold text-slate-900">{{ this.totalItems }}</span> spectacle{{ this.totalItems > 1 ?
            's' : '' }}.
        </p>

        {# Navigation (Si plus d'1 page) #}
        {% if this.maxPages > 1 %}
        <nav class="inline-flex shadow-sm rounded-lg border border-slate-200 bg-white overflow-hidden font-semibold">

            {# Précédent #}
            <button type="button" data-action="live#update" data-model="page" data-value="{{ this.page - 1 }}"
                class="px-3 py-1.5 text-slate-600 hover:bg-slate-50 border-r border-slate-200 disabled:opacity-40 disabled:hover:bg-white transition cursor-pointer"
                {{ this.page <=1 ? 'disabled' : '' }}>
                Précédent
            </button>

            {# Page active / Max #}
            <span
                class="px-3.5 py-1.5 bg-indigo-600 text-white border-r border-slate-200 flex items-center justify-center">
                {{ this.page }} / {{ this.maxPages }}
            </span>

            {# Suivant #}
            <button type="button" data-action="live#update" data-model="page" data-value="{{ this.page + 1 }}"
                class="px-3 py-1.5 text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:hover:bg-white transition cursor-pointer"
                {{ this.page>= this.maxPages ? 'disabled' : '' }}>
                Suivant
            </button>
        </nav>
        {% endif %}

    </div>
    {% endif %}
</div>

</div>