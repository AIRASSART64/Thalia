{% set totalItems = this.totalItems|default(this.totalShows|default(this.totalContacts|default(0))) %}
{% set maxPages = this.maxPages|default(this.totalPages|default(1)) %}
{% set itemsPerPage = this.itemsPerPage|default(10) %}
{% set currentLabel = this.itemLabel|default('résultats') %}

<div class="mt-6 hidden sm:flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
    
    {# Infos de compteur (1 à 10 sur 25...) #}
    <div class="text-xs text-slate-500 font-medium">
        Affichage de 
        <span class="font-bold text-slate-700">
            {{ this.pageStart|default(((this.page - 1) * itemsPerPage) + 1) }}
        </span> 
        à 
        <span class="font-bold text-slate-700">
            {{ this.pageEnd|default(min(this.page * itemsPerPage, totalItems)) }}
        </span> 
        sur 
        <span class="font-bold text-slate-700">{{ totalItems }}</span> {{ currentLabel }}
    </div>

    {# Boutons de navigation #}
    {% if maxPages > 1 %}
    <div class="flex items-center gap-1.5">
        {# Bouton Précédent #}
        <button type="button"
                data-action="live#action"
                data-live-action-param="setPage"
                data-live-page-param="{{ this.page - 1 }}"
                {% if this.page <= 1 %}disabled{% endif %}
                class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center gap-1 cursor-pointer">
            <i class="fa-solid fa-chevron-left text-[10px]"></i>
            <span>Précédent</span>
        </button>

        {# Pages numérotées #}
        <div class="hidden sm:flex items-center gap-1">
            {% for i in 1..maxPages %}
                {% if i == 1 or i == maxPages or (i >= this.page - 1 and i <= this.page + 1) %}
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="setPage"
                            data-live-page-param="{{ i }}"
                            class="w-8 h-8 rounded-lg text-xs font-bold transition flex items-center justify-center cursor-pointer {{ i == this.page ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-600 hover:bg-slate-100' }}">
                        {{ i }}
                    </button>
                {% elseif (i == 2 and this.page > 3) or (i == maxPages - 1 and this.page < maxPages - 2) %}
                    <span class="w-6 text-center text-xs text-slate-400">...</span>
                {% endif %}
            {% endfor %}
        </div>

        {# Bouton Suivant #}
        <button type="button"
                data-action="live#action"
                data-live-action-param="setPage"
                data-live-page-param="{{ this.page + 1 }}"
                {% if this.page >= maxPages %}disabled{% endif %}
                class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center gap-1 cursor-pointer">
            <span>Suivant</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </button>
    </div>
    {% endif %}
</div>