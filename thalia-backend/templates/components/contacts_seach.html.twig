<div {{ attributes }}>
    
    {# ─── BARRE DE FILTRES ─── #}
    <div class="filter-bar">
        
        {# Pills Filtres par Rôle #}
        <div class="flex flex-wrap items-center gap-1.5">
            {% set roles = ['Tous', 'Agent', 'Directeur', 'Technicien'] %}
            {% for r in roles %}
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="role"
                        data-live-role-param="{{ r }}"
                        data-model="role"
                        value="{{ r }}"
                        class="filter-pill {{ role == r ? 'active' : '' }}">
                    {{ r }}
                </button>
            {% endfor %}
        </div>

        {# Outils : Recherche + Tri #}
        <div class="flex items-center gap-2 w-full md:w-auto justify-between md:justify-end">
            
            {# Partial Champ de Recherche #}
            {% include 'components/_search_bar.html.twig' with {
                placeholder: 'Rechercher nom, email...'
            } %}

            {# Bouton de Tri #}
            <button type="button"
                    data-action="live#action"
                    data-live-action-param="sort"
                    data-model="sort"
                    value="{{ sort == 'name_asc' ? 'name_desc' : 'name_asc' }}"
                    class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-50 rounded-xl border border-slate-100 transition shrink-0"
                    title="Trier par ordre alphabétique">
                <i class="fa-solid fa-arrow-down-a-z {{ sort == 'name_desc' ? 'rotate-180' : '' }} transition-transform"></i>
            </button>
        </div>
    </div>

    {# Partial Loader AJAX #}
    {% include 'components/_search_loader.html.twig' with {
        label: 'Mise à jour de la liste des contacts...'
    } %}

    {# ─── GRILLE DES CONTACTS ─── #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {% for contact in this.contacts %}
            <a href="{{ path('contact_show', {'id': contact.id}) }}" class="search-card block group hover:border-indigo-200 transition">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100 text-slate-500 font-bold text-sm group-hover:bg-indigo-50 group-hover:text-indigo-600 transition">
                        {{ contact.firstName|slice(0,1)|upper }}{{ contact.lastName|slice(0,1)|upper }}
                    </div>
                    <div class="min-w-0">
                        <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition truncate text-sm">
                            {{ contact.firstName }} {{ contact.lastName }}
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5 truncate">{{ contact.companyName|default('Indépendant') }}</p>
                    </div>
                </div>
            </a>
        {% else %}
            <div class="empty-results">
                <i class="fa-solid fa-users-slash text-2xl mb-2 block text-slate-300"></i>
                Aucun contact ne correspond à vos critères.
            </div>
        {% endfor %}
    </div>

</div>