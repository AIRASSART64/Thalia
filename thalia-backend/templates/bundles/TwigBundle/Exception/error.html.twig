{% extends 'base.html.twig' %}

{% block title %}Une erreur est survenue{% endblock %}

{% block body %}
<div class="min-h-[70vh] flex items-center justify-center p-6">
    <div class="text-center max-w-md bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
        <div class="w-16 h-16 bg-red-50 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 mb-2">Une erreur est survenue</h1>
        <p class="text-slate-500 text-sm mb-6">
            Une erreur inattendue s'est produite. Si le problème persiste, veuillez contacter l'administrateur.
        </p>
        <a href="{{ path('home') }}" 
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg transition">
            <span>Retour à l'accueil</span>
        </a>
    </div>
</div>
{% endblock %}