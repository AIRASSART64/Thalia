{% extends 'base.html.twig' %}

{% block title %}Page non trouvée (404){% endblock %}

{% block body %}
<div class="min-h-[70vh] flex items-center justify-center p-6">
    <div class="text-center max-w-md bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
        <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
            404
        </div>
        <h1 class="text-2xl font-bold text-slate-900 mb-2">Page introuvable</h1>
        <p class="text-slate-500 text-sm mb-6">
            Désolé, la page que vous recherchez n'existe pas ou a été déplacée.
        </p>
        <a href="{{ path('home') }}" 
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition shadow-xs">
            <i class="fa-solid fa-house"></i>
            <span>Retour à l'accueil</span>
        </a>
    </div>
</div>
{% endblock %}