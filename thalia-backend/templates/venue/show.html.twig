{% extends 'base.html.twig' %}

{% block title %}Thalia — {{ venue.name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 text-slate-800 pb-12" x-data="{ activeTab: 'technique' }">
    
    {# ─── BREADCRUMB ─── #}
    <nav class="text-xs text-slate-400 mb-4 px-4 sm:px-6 pt-4 max-w-7xl mx-auto" aria-label="Breadcrumb">
        <ol class="list-none p-0 inline-flex space-x-2">
            <li class="flex items-center">
                <a href="#" class="hover:text-slate-600 transition-colors">Établissement</a>
                <span class="mx-2">/</span>
            </li>
            <li class="flex items-center">
                <a href="{{ path('venue_index') }}" class="hover:text-slate-600 transition-colors">Salles</a>
                <span class="mx-2">/</span>
            </li>
            <li class="text-slate-600 font-medium truncate" aria-current="page">{{ venue.name }}</li>
        </ol>
    </nav>

    <div class="px-4 sm:px-6 max-w-7xl mx-auto space-y-6">

        {# ─── 1. BANNIÈRE PRINCIPALE ─── #}
        <div class="relative h-60 sm:h-80 rounded-2xl overflow-hidden shadow-lg bg-slate-900 text-white">
            {% if venue.venueImage %}
                <img src="{{ path('secure_venue_image', {'id': venue.id}) }}" alt="{{ venue.name }}" class="w-full h-full object-cover opacity-80">
            {% else %}
                <div class="w-full h-full bg-gradient-to-r from-slate-900 to-indigo-950 flex items-center justify-center">
                    <i class="fa-solid fa-masks-theater text-5xl sm:text-6xl text-slate-800"></i>
                </div>
            {% endif %}
            
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>

            <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 space-y-1 pr-24">
                <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-white leading-tight">{{ venue.name }}</h1>
            </div>

            {% if is_granted('VENUE_EDIT', venue) %}
                <div class="absolute bottom-4 sm:bottom-6 right-4 sm:right-6">
                    <a href="{{ path('venue_edit', {'id': venue.id}) }}" class="inline-flex items-center gap-2 px-3 py-2 sm:px-4 sm:py-2.5 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white font-medium text-xs rounded-xl shadow-md transition-all">
                        <i class="fa-solid fa-pen-to-square text-xs sm:text-sm"></i>
                        <span>Modifier</span>
                    </a>
                </div>
            {% endif %}
        </div>

        {# ─── 2. SYSTÈME D'ONGLETS ─── #}
        <div class="bg-white border border-slate-100 rounded-2xl shadow-sm overflow-hidden">
            
            {# Barre de navigation optimisée Mobile (Scroll H-Nav) #}
            <div class="flex border-b border-slate-100 bg-slate-50/50 px-4 sm:px-6 pt-3 gap-1 sm:gap-2 overflow-x-auto no-scrollbar scroll-smooth">
                <button 
                    @click="activeTab = 'technique'"
                    :class="activeTab === 'technique' ? 'border-indigo-600 text-indigo-600 bg-white font-semibold' : 'border-transparent text-slate-500 hover:text-slate-800 font-medium'"
                    class="py-3 px-3 sm:px-4 border-b-2 text-xs sm:text-sm transition-all rounded-t-xl flex items-center gap-2 whitespace-nowrap shrink-0">
                    <i class="fa-solid fa-sliders text-xs"></i>
                    <span>Informations techniques</span>
                </button>

                <button 
                    @click="activeTab = 'spectacles'"
                    :class="activeTab === 'spectacles' ? 'border-indigo-600 text-indigo-600 bg-white font-semibold' : 'border-transparent text-slate-500 hover:text-slate-800 font-medium'"
                    class="py-3 px-3 sm:px-4 border-b-2 text-xs sm:text-sm transition-all rounded-t-xl flex items-center gap-2 whitespace-nowrap shrink-0">
                    <i class="fa-solid fa-calendar-days text-xs"></i>
                    <span>Spectacles</span>
                </button>

                <button 
                    @click="activeTab = 'medias'"
                    :class="activeTab === 'medias' ? 'border-indigo-600 text-indigo-600 bg-white font-semibold' : 'border-transparent text-slate-500 hover:text-slate-800 font-medium'"
                    class="py-3 px-3 sm:px-4 border-b-2 text-xs sm:text-sm transition-all rounded-t-xl flex items-center gap-2 whitespace-nowrap shrink-0">
                    <i class="fa-solid fa-folder-open text-xs"></i>
                    <span>Médias & Plans</span>
                </button>

                <button 
                    @click="activeTab = 'inventaire'"
                    :class="activeTab === 'inventaire' ? 'border-indigo-600 text-indigo-600 bg-white font-semibold' : 'border-transparent text-slate-500 hover:text-slate-800 font-medium'"
                    class="py-3 px-3 sm:px-4 border-b-2 text-xs sm:text-sm transition-all rounded-t-xl flex items-center gap-2 whitespace-nowrap shrink-0">
                    <i class="fa-solid fa-boxes-packing text-xs"></i>
                    <span>Inventaire matériel</span>
                </button>
            </div>

            {# CONTENU DES ONGLETS #}
            <div class="p-4 sm:p-6">
                
                {# ─── ONGLET 1 : INFORMATIONS TECHNIQUES ─── #}
                <div x-show="activeTab === 'technique'" class="space-y-6 sm:space-y-8">
                    
                    {# Ligne 1 : Dimensions #}
                    <div class="space-y-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i class="fa-solid fa-ruler-combined text-indigo-500"></i> Dimensions de la scène
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Ouverture cadre</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.stageWidth|default('0.0') }} <span class="text-xs font-normal text-slate-500">m</span></span>
                            </div>

                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Profondeur</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.stageDepth|default('0.0') }} <span class="text-xs font-normal text-slate-500">m</span></span>
                            </div>

                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Hauteur sous perches</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.stageHeight|default('0.0') }} <span class="text-xs font-normal text-slate-500">m</span></span>
                            </div>
                        </div>
                    </div>

                    <hr class="border-slate-100">

                    {# Ligne 2 : Capacités #}
                    <div class="space-y-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i class="fa-solid fa-users text-indigo-500"></i> Capacité de la salle
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                            <div class="p-3.5 sm:p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 flex justify-between items-center">
                                <span class="text-xs font-bold text-indigo-600 uppercase">Capacité Max.</span>
                                <span class="text-lg sm:text-xl font-black text-indigo-900">{{ venue.maxCapacity|default(0)|number_format(0, ',', ' ') }}</span>
                            </div>

                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Places Assises</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.seatsCount|default(0)|number_format(0, ',', ' ') }}</span>
                            </div>

                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Places Debout</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.standingCount|default(0)|number_format(0, ',', ' ') }}</span>
                            </div>

                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Accès PMR</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.pmrCount|default(0)|number_format(0, ',', ' ') }}</span>
                            </div>
                        </div>
                    </div>

                    <hr class="border-slate-100">

                    {# Ligne 3 : Invitations #}
                    <div class="space-y-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i class="fa-solid fa-ticket text-indigo-500"></i> Invitations
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
                            <div class="p-3.5 sm:p-4 bg-slate-50/70 rounded-xl border border-slate-100 flex justify-between items-center">
                                <span class="text-xs font-medium text-slate-500">Quota d'invitations</span>
                                <span class="text-base sm:text-lg font-bold text-slate-800">{{ venue.invitationQuota|default(0)|number_format(0, ',', ' ') }}</span>
                            </div>
                        </div>
                    </div>

                </div>

                {# ─── ONGLET 2 : SPECTACLES ─── #}
                <div x-show="activeTab === 'spectacles'" x-cloak class="space-y-4">
                    <div class="py-12 text-center bg-slate-50/50 border border-dashed border-slate-200 rounded-xl">
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fa-solid fa-calendar-xmark text-lg"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-slate-800 mb-1">Aucun spectacle programmé</h3>
                        <p class="text-xs text-slate-400 max-w-sm mx-auto">L'historique et la programmation des spectacles associés à cette salle apparaîtront ici.</p>
                    </div>
                </div>

                {# ─── ONGLET 3 : MÉDIAS & PLANS ─── #}
                <div x-show="activeTab === 'medias'" x-cloak class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        
                        {# Image de la salle #}
                        <div class="border border-slate-100 rounded-xl p-4 bg-slate-50/50 space-y-3">
                            <div class="flex items-center justify-between">
                                <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                                    <i class="fa-regular fa-image text-slate-400"></i> Visuel de la salle
                                </h4>
                            </div>
                            
                            {% if venue.venueImage %}
                                <div class="relative h-48 sm:h-56 rounded-lg overflow-hidden border border-slate-200 bg-slate-900 group">
                                    <img src="{{ path('secure_venue_image', {'id': venue.id}) }}" alt="{{ venue.name }}" class="w-full h-full object-cover">
                                    <a href="{{ path('secure_venue_image', {'id': venue.id}) }}" target="_blank" class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-medium gap-2">
                                        <i class="fa-solid fa-up-right-and-down-left-from-center"></i> Agrandir
                                    </a>
                                </div>
                            {% else %}
                                <div class="h-48 sm:h-56 rounded-lg border border-dashed border-slate-200 flex flex-col items-center justify-center text-slate-400 bg-white">
                                    <i class="fa-regular fa-image text-3xl mb-2 text-slate-300"></i>
                                    <span class="text-xs">Aucune image enregistrée</span>
                                </div>
                            {% endif %}
                        </div>

                        {# Plan technique de la salle #}
                        <div class="border border-slate-100 rounded-xl p-4 bg-slate-50/50 space-y-3">
                            <div class="flex items-center justify-between">
                                <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                                    <i class="fa-regular fa-file-pdf text-slate-400"></i> Plan d'implantation / PDF
                                </h4>
                            </div>

                            {% if venue.venuePlan %}
                                <div class="h-48 sm:h-56 rounded-lg border border-slate-200 bg-white p-6 flex flex-col items-center justify-center text-center space-y-3">
                                    <div class="w-12 h-12 bg-rose-50 text-rose-500 rounded-xl flex items-center justify-center">
                                        <i class="fa-solid fa-file-pdf text-xl"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-slate-800">Plan_technique_{{ venue.name }}.pdf</p>
                                        <p class="text-[11px] text-slate-400 mt-0.5">Document technique disponible</p>
                                    </div>
                                    <a href="{{ path('secure_venue_plan', {'id': venue.id}) }}" target="_blank" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-medium transition-colors shadow-sm inline-flex items-center gap-2">
                                        <i class="fa-solid fa-download"></i> Consulter le document
                                    </a>
                                </div>
                            {% else %}
                                <div class="h-48 sm:h-56 rounded-lg border border-dashed border-slate-200 flex flex-col items-center justify-center text-slate-400 bg-white">
                                    <i class="fa-regular fa-file-pdf text-3xl mb-2 text-slate-300"></i>
                                    <span class="text-xs">Aucun plan PDF associé</span>
                                </div>
                            {% endif %}
                        </div>

                    </div>
                </div>

                {# ─── ONGLET 4 : INVENTAIRE MATÉRIEL ─── #}
                <div x-show="activeTab === 'inventaire'" x-cloak class="space-y-4">
                    <div class="py-12 text-center bg-slate-50/50 border border-dashed border-slate-200 rounded-xl">
                        <div class="w-12 h-12 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fa-solid fa-boxes-packing text-lg"></i>
                        </div>
                        <h3 class="text-sm font-semibold text-slate-800 mb-1">Inventaire vide</h3>
                        <p class="text-xs text-slate-400 max-w-sm mx-auto">Aucun équipement ou matériel scénique n'est directement rattaché à cette salle pour le moment.</p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
{% endblock %}