{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

{# ─── ALERTE GLOBALE EN HAUT SI ERREURS ─── #}
{% if not form.vars.valid %}
<div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs shadow-sm">
    <div class="flex items-center gap-2 font-bold mb-1 text-rose-700">
        <i class="fa-solid fa-triangle-exclamation text-sm"></i>
        <span>Des erreurs sont survenues dans le formulaire :</span>
    </div>
    <ul class="list-disc list-inside space-y-0.5 text-rose-700 font-medium">
        {{ form_errors(form) }}
        {% for child in form.children %}
            {% for error in child.vars.errors %}
            <li>
                <strong>{{ child.vars.label|default(child.vars.name) }} :</strong> {{ error.message }}
            </li>
            {% endfor %}
        {% endfor %}
    </ul>
</div>
{% endif %}

<div class="form-card">

    {# ─── 1. INFORMATIONS GÉNÉRALES ─── #}
    <div class="border-b border-gray-100 pb-6 space-y-4">
        <h2 class="form-section-title">
            Informations Générales
        </h2>

        <div class="form-group {% if not form.name.vars.valid %}has-error{% endif %}">
            {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-input', 'placeholder': 'Ex: Grande Salle, Le Cube...'}}) }}
            {{ form_errors(form.name) }}
        </div>
    </div>

    {# ─── 2. DONNÉES TECHNIQUES & DIMENSIONS ─── #}
    <div class="border-b border-gray-100 py-6 space-y-4">
        <h2 class="form-section-title">
            Dimensions de la Scène
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="form-group {% if not form.stageWidth.vars.valid %}has-error{% endif %}">
                {{ form_label(form.stageWidth, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.stageWidth, {'attr': {'class': 'form-input', 'placeholder': '0.00'}}) }}
                {{ form_errors(form.stageWidth) }}
            </div>

            <div class="form-group {% if not form.stageDepth.vars.valid %}has-error{% endif %}">
                {{ form_label(form.stageDepth, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.stageDepth, {'attr': {'class': 'form-input', 'placeholder': '0.00'}}) }}
                {{ form_errors(form.stageDepth) }}
            </div>

            <div class="form-group {% if not form.stageHeight.vars.valid %}has-error{% endif %}">
                {{ form_label(form.stageHeight, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.stageHeight, {'attr': {'class': 'form-input', 'placeholder': '0.00'}}) }}
                {{ form_errors(form.stageHeight) }}
            </div>
        </div>
    </div>

    {# ─── 3. CAPACITÉ DE LA SALLE ─── #}
    <div class="border-b border-gray-100 py-6 space-y-4">
        <h2 class="form-section-title">
            Capacité & Jauge
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="form-group {% if not form.maxCapacity.vars.valid %}has-error{% endif %}">
                {{ form_label(form.maxCapacity, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.maxCapacity, {'attr': {'class': 'form-input', 'placeholder': '0'}}) }}
                {{ form_errors(form.maxCapacity) }}
            </div>

            <div class="form-group {% if not form.seatsCount.vars.valid %}has-error{% endif %}">
                {{ form_label(form.seatsCount, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.seatsCount, {'attr': {'class': 'form-input', 'placeholder': '0'}}) }}
                {{ form_errors(form.seatsCount) }}
            </div>

            <div class="form-group {% if not form.standingCount.vars.valid %}has-error{% endif %}">
                {{ form_label(form.standingCount, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.standingCount, {'attr': {'class': 'form-input', 'placeholder': '0'}}) }}
                {{ form_errors(form.standingCount) }}
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="form-group {% if not form.pmrCount.vars.valid %}has-error{% endif %}">
                {{ form_label(form.pmrCount, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.pmrCount, {'attr': {'class': 'form-input', 'placeholder': '0'}}) }}
                {{ form_errors(form.pmrCount) }}
            </div>

            <div class="form-group {% if not form.invitationQuota.vars.valid %}has-error{% endif %}">
                {{ form_label(form.invitationQuota, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.invitationQuota, {'attr': {'class': 'form-input', 'placeholder': '0'}}) }}
                {{ form_errors(form.invitationQuota) }}
            </div>
        </div>
    </div>

    {# ─── 4. MÉDIAS ET DOCUMENTS ATTACHÉS ─── #}
    <div class="pt-6 space-y-4">
        <h2 class="form-section-title">
            Fichiers & Visuels
        </h2>

        {# 🖼️ Photo de la salle (venueImageFile) #}
        <div class="form-group {% if not form.venueImageFile.vars.valid %}has-error{% endif %}">
            {{ form_label(form.venueImageFile, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="form-file-box">
                <div class="form-file-preview w-16 h-16 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shrink-0">
                    {% if venue is defined and venue.id and venue.venueImage %}
                        <img id="venue-image-preview-img" src="{{ path('secure_venue_image', {'id': venue.id}) }}" class="w-full h-full object-cover" alt="Visuel actuel">
                        <i id="venue-image-preview-icon" class="fa-regular fa-image text-xl hidden"></i>
                    {% else %}
                        <i id="venue-image-preview-icon" class="fa-regular fa-image text-xl text-slate-400"></i>
                        <img id="venue-image-preview-img" src="" class="w-full h-full object-cover hidden" alt="Prévisualisation">
                    {% endif %}
                </div>
                <div class="grow w-full">
                    {{ form_widget(form.venueImageFile, {
                        'attr': {
                            'class': 'form-input-sm',
                            'accept': 'image/jpeg,image/png,image/webp',
                            'onchange': "handleImagePreview(this, 'venue-image-preview-img', 'venue-image-preview-icon')"
                        }
                    }) }}
                    <p class="form-help-text">Format JPG, PNG ou WebP - Max 5 Mo.</p>
                </div>
            </div>
            {{ form_errors(form.venueImageFile) }}
        </div>

        {# 📄 Plan technique (venuePlanFile) #}
        <div class="form-group {% if not form.venuePlanFile.vars.valid %}has-error{% endif %}">
            {{ form_label(form.venuePlanFile, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="form-file-box">
                <div class="form-file-preview w-12 h-12 rounded-lg bg-red-50 text-red-500 border border-red-100 flex items-center justify-center shrink-0">
                    <i class="fa-regular fa-file-pdf text-2xl"></i>
                </div>

                <div class="grow w-full space-y-1">
                    {{ form_widget(form.venuePlanFile, {
                        'attr': {
                            'class': 'form-input-sm',
                            'accept': 'application/pdf,image/jpeg,image/png',
                            'onchange': "handleDocumentPreview(this, 'pdf-plan-info')"
                        }
                    }) }}

                    <div id="pdf-plan-info" class="flex items-center gap-2 text-xs text-gray-600 mt-1">
                        {% if venue is defined and venue.id and venue.venuePlan %}
                            <span class="font-medium text-emerald-600">
                                <i class="fa-solid fa-circle-check text-emerald-500"></i> Plan actuel :
                            </span>
                            <a href="{{ path('secure_venue_plan', {'id': venue.id}) }}" target="_blank" class="font-semibold text-indigo-600 hover:text-indigo-800 underline inline-flex items-center gap-1">
                                <i class="fa-solid fa-download text-[10px]"></i> {{ venue.venuePlan }}
                            </a>
                        {% else %}
                            <p class="form-help-text">Format PDF, JPEG ou PNG - Max 10 Mo.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            {{ form_errors(form.venuePlanFile) }}
        </div>
    </div>

    {# ─── ACTIONS ─── #}
    <div class="form-actions mt-6">
        <a href="{{ path('organization') }}" class="btn-cancel">
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            {{ button_label|default('Enregistrer') }} <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </button>
    </div>

</div>

{{ form_rest(form) }}
{{ form_end(form) }}