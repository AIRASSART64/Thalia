{% extends 'base.html.twig' %}

{% block title %}Thalia — Modifier {{ venue.name }}{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card modal-card-lg">
        
        <a href="{{ path('venue_index') }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">Modifier la salle</h1>
                <p class="text-xs text-indigo-500 font-medium mt-0.5">{{ venue.name }}</p>
            </div>
        </div>

        {{ include('venue/_form.html.twig', {'button_label': 'Sauvegarder les modifications'}) }}
        
    </div>
</div>
{% endblock %}