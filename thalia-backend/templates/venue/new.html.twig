{% extends 'base.html.twig' %}

{% block title %}Thalia — Nouvelle salle{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card modal-card-lg">
        
        <a href="{{ path('organization') }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Ajouter une nouvelle salle</h1>
            <p class="text-xs text-indigo-500 mt-1 font-medium">Configurez un nouvel espace scénique pour votre organisation.</p>
        </div>

        {{ include('venue/_form.html.twig', {'button_label': 'Créer la salle'}) }}
        
    </div>
</div>
{% endblock %}