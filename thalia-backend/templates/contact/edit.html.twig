{% extends 'base.html.twig' %}

{% block title %}Thalia - Modifier {{ contact.firstName }} {{ contact.lastName }}{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card">
        
        <a href="{{ path('contact_show', {'id': contact.id}) }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">Modifier le contact</h1>
                <p class="text-xs text-indigo-500 font-medium">{{ contact.firstName }} {{ contact.lastName }}</p>
            </div>

            {# Bouton de suppression discret placé en haut de modale #}
            {# <form method="post" action="{{ path('contact_delete', {'id': contact.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement ce contact ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
                <button type="submit" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold text-xs transition">
                    <i class="fa-regular fa-trash-can"></i> Supprimer
                </button>
            </form> #}
        </div>

        {{ include('contact/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
        
    </div>
</div>
{% endblock %}