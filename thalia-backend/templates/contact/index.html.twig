{% extends 'base.html.twig' %}

{% block title %}Thalia - Base de Contacts{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-gray-50 text-slate-800">
    
    {% include "components/_sidebar.html.twig" %}

    {# ─── CONTENU PRINCIPAL ─── #}
    <main class="grow p-6 lg:p-8 max-w-7xl mx-auto space-y-8 w-full">
        
        {# En-tête de page #}
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <nav class="flex mb-2 text-xs font-semibold text-slate-400 uppercase tracking-wider gap-2">
                    <a href="#" class="hover:text-slate-600">CRM</a>
                    <span>/</span>
                    <span class="text-slate-500">Base de Contacts</span>
                </nav>
                <h1 class="text-2xl font-black text-gray-900 tracking-tight">Base de Contacts</h1>
                <p class="text-sm text-slate-500 mt-1">Gérez vos relations professionnelles et coordonnées.</p>
            </div>
            <div class="flex items-center gap-2 self-end sm:self-auto">
                <a href="{{ path('contact_new') }}" class="btn-indigo">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>Nouveau Contact</span>
                </a>
            </div>
        </div>

        {# ─── COMPOSANT DE RECHERCHE LIVE ─── #}
        {{ component('contact_search') }}

    </main>
</div>

{# Bouton d'action flottant (+) mobile #}
<a href="{{ path('contact_new') }}" class="md:hidden fixed bottom-20 right-5 w-12 h-12 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full flex items-center justify-center shadow-xl hover:shadow-2xl transition-all duration-200 z-50 active:scale-95">
    <i class="fa-solid fa-plus text-lg"></i>
</a>
{% endblock %}