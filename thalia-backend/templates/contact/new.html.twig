{% extends 'base.html.twig' %}

{% block title %}Thalia - Nouveau Contact{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card">
        
        <a href="{{ path('contact_index') }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Ajouter un contact</h1>
            <p class="text-xs text-indigo-500 mt-1 font-medium">Ajoutez une nouvelle relation à votre réseau professionnel CRM.</p>
        </div>

        {{ include('contact/_form.html.twig', {'button_label': 'Créer le contact'}) }}
        
    </div>
</div>
{% endblock %}