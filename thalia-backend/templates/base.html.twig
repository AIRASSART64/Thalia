<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Thalia SaaS{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">
    {# <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> #}

    {# CDN Bibliothèques tierces #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    {# Tailwind CDN #}
    <script src="https://cdn.tailwindcss.com"></script>

    {% block stylesheets %}{% endblock %}

    {# Importation centralisée JS & CSS via AssetMapper #}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script defer src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

<body class="bg-gray-50 min-h-screen font-sans flex flex-col justify-between">

    {# ─── HEADER SOMBRE ─── #}
    <header class="bg-black shadow-md border-b border-neutral-800 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                {# Logo & Badges #}
                <div class="flex items-center gap-2.5">
                    <a href="{{ path('home') }}"
                        class="text-2xl font-black tracking-wider text-indigo-400 hover:text-indigo-300 transition">THALIA</a>
                    {% if app.user %}
                        {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
                            <span class="text-[10px] bg-red-950/80 text-red-300 border border-red-800/50 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">SuperAdmin</span>
                        {% else %}
                            <span class="text-[10px] bg-indigo-950/80 text-indigo-300 border border-indigo-800/50 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">SaaS</span>
                        {% endif %}
                    {% endif %}
                </div>

                {# Actions Desktop #}
                <div class="hidden sm:flex items-center gap-4">
                    {% if app.user %}
                        {% set profileUrl = ('ROLE_SUPER_ADMIN' in app.user.roles) ? path('profile_index') : path('profile_index') %}

                        {# Profile Link #}
                        <a href="{{ profileUrl }}" class="flex items-center gap-2.5 text-sm text-slate-300 hover:text-white transition group mr-2">
                            {% if app.user.avatarFilename %}
                                <div class="w-8 h-8 rounded-full bg-neutral-800 border border-neutral-700 overflow-hidden shrink-0 group-hover:border-indigo-400 transition">
                                    <img src="{{ path('secure_profile', {'id': app.user.id}) }}" 
                                         alt="Avatar de {{ app.user.firstName }}" 
                                         class="w-full h-full object-cover">
                                </div>
                            {% else %}
                                <i class="fa-regular fa-circle-user text-neutral-400 group-hover:text-indigo-400 text-lg transition"></i>
                            {% endif %}
                            <span class="font-semibold text-slate-200 group-hover:text-white transition">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                        </a>

                        {# Déconnexion #}
                        <a href="{{ path('app_logout') }}"
                            class="text-xs bg-neutral-800 text-slate-300 border border-neutral-700/60 px-3 py-2 rounded-lg hover:bg-neutral-700 hover:text-white transition">
                            <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('register') }}"
                            class="text-xs bg-indigo-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-indigo-500 transition shadow-sm">
                            Créer un compte
                        </a>
                    {% endif %}
                </div>

                {# Bouton Burger Mobile #}
                <div class="sm:hidden flex items-center">
                    <button type="button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
                        class="text-neutral-400 hover:text-white p-2 focus:outline-none" aria-label="Menu">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        {# ─── MENU MOBILE SOMBRE ─── #}
        <div id="mobile-menu"
            class="hidden sm:hidden border-t border-neutral-800 bg-black px-4 pt-3 pb-4 space-y-3 shadow-2xl">
            {% if app.user %}
                {% set profileUrl = ('ROLE_SUPER_ADMIN' in app.user.roles) ? path('superadmin_dashboard') : path('profile_index') %}

                <a href="{{ profileUrl }}" class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-neutral-900 transition border border-transparent hover:border-neutral-800">
                    {% if app.user.avatarFilename %}
                        <div class="w-9 h-9 rounded-full bg-neutral-800 border border-neutral-700 overflow-hidden shrink-0">
                            <img src="{{ path('secure_profile', {'id': app.user.id}) }}" 
                                 alt="Avatar de {{ app.user.firstName }}" 
                                 class="w-full h-full object-cover">
                        </div>
                    {% else %}
                        <i class="fa-regular fa-circle-user text-neutral-400 text-2xl"></i>
                    {% endif %}
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-slate-100">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                        <span class="text-[11px] text-neutral-400 truncate">{{ app.user.email }}</span>
                    </div>
                </a>

                <a href="{{ path('app_logout') }}"
                    class="block text-center text-sm font-medium text-slate-300 bg-neutral-800 hover:bg-neutral-700 hover:text-white px-3 py-2 rounded-lg border border-neutral-700/60 transition">
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('register') }}"
                    class="block text-center text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white py-2.5 rounded-lg shadow-sm transition">
                    Créer un compte
                </a>
            {% endif %}
        </div>
    </header>

    <main class="grow w-full">
        {% block body %}{% endblock %}
    </main>

    {# ─── FOOTER SOMBRE ─── #}
    <footer class="bg-black border-t border-neutral-800 py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400">
            <div class="flex flex-wrap justify-center sm:justify-start gap-x-4 gap-y-1">
                <span>&copy; 2026 Thalia SaaS. Tous droits réservés.</span>
            </div>
            <div class="flex gap-4">
                <a href="#" class="hover:text-slate-200 transition">Mentions légales</a>
                <a href="#" class="hover:text-slate-200 transition">Confidentialité</a>
                <a href="#" class="hover:text-slate-200 transition">Support</a>
            </div>
        </div>
    </footer>

</body>
</html>