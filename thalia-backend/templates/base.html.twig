<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Thalia SaaS{% endblock %}</title>
    
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {# CDN Bibliothèques tierces #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    {# Tailwind CDN #}
    <script src="https://cdn.tailwindcss.com"></script>

    {% block stylesheets %}{% endblock %}

    {# Importation centralisée JS & CSS via AssetMapper #}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script defer src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

<body class="bg-gray-50 min-h-screen font-sans flex flex-col justify-between">

    <header class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <div class="flex items-center gap-2">
                    <a href="{{ path('home') }}"
                        class="text-2xl font-black tracking-wider text-indigo-600 hover:opacity-90 transition">THALIA</a>
                    {% if app.user %}
                        {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
                            <span class="text-[10px] bg-red-50 text-red-700 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">SuperAdmin</span>
                        {% else %}
                            <span class="text-[10px] bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">SaaS Tenant</span>
                        {% endif %}
                    {% endif %}
                </div>

                <div class="hidden sm:flex items-center gap-4">
                    {% if app.user %}
                        {# Détermination de la destination du profil #}
                        {% set profileUrl = ('ROLE_SUPER_ADMIN' in app.user.roles) ? path('superadmin_dashboard') : path('profile_index') %}

                        {# ─── BLOC PROFILE DEVENU CLIQUABLE (DESKTOP) ─── #}
                        <a href="{{ profileUrl }}" class="flex items-center gap-2.5 text-sm text-gray-700 hover:text-indigo-600 transition group mr-2">
                            {% if app.user.avatarFilename %}
                                <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-200 overflow-hidden shrink-0 shadow-xs group-hover:border-indigo-400 transition">
                                    <img src="{{ path('secure_profile', {'id': app.user.id}) }}" 
                                         alt="Avatar de {{ app.user.firstName }}" 
                                         class="w-full h-full object-cover">
                                </div>
                            {% else %}
                                <i class="fa-regular fa-circle-user text-gray-400 group-hover:text-indigo-600 text-lg transition"></i>
                            {% endif %}
                            <span class="font-semibold text-slate-800 group-hover:text-indigo-600 transition">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                        </a>

                        <a href="{{ path('app_logout') }}"
                            class="text-xs bg-gray-100 text-gray-600 px-3 py-2 rounded-lg hover:bg-gray-200 transition">
                            <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('register') }}"
                            class="text-xs bg-indigo-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition shadow-sm shadow-indigo-100">
                            Créer un compte
                        </a>
                    {% endif %}
                </div>

                <div class="sm:hidden flex items-center">
                    <button type="button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
                        class="text-gray-500 hover:text-gray-600 p-2 focus:outline-none" aria-label="Menu">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        {# ─── MENU MOBILE ─── #}
        <div id="mobile-menu"
            class="hidden sm:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-4 space-y-3 shadow-inner">
            {% if app.user %}
                {% set profileUrl = ('ROLE_SUPER_ADMIN' in app.user.roles) ? path('superadmin_dashboard') : path('profile_index') %}

                <a href="{{ profileUrl }}" class="flex items-center gap-3 px-2 py-1 rounded-lg hover:bg-gray-50 transition">
                    {% if app.user.avatarFilename %}
                        <div class="w-9 h-9 rounded-full bg-slate-100 border border-slate-200 overflow-hidden shrink-0">
                            <img src="{{ path('secure_profile', {'id': app.user.id}) }}" 
                                 alt="Avatar de {{ app.user.firstName }}" 
                                 class="w-full h-full object-cover">
                        </div>
                    {% else %}
                        <i class="fa-regular fa-circle-user text-gray-400 text-2xl"></i>
                    {% endif %}
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-slate-800">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                        <span class="text-[11px] text-gray-400 truncate">{{ app.user.email }}</span>
                    </div>
                </a>

                <a href="{{ path('app_logout') }}"
                    class="block text-sm font-medium text-gray-600 bg-gray-50 px-3 py-2 rounded-lg">Déconnexion</a>
            {% else %}
                <a href="{{ path('register') }}"
                    class="block text-center text-sm font-semibold bg-indigo-600 text-white py-2.5 rounded-lg shadow-sm">Créer un compte</a>
            {% endif %}
        </div>
    </header>

    <main class="grow w-full">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-white border-t border-gray-100 py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
            <div class="flex flex-wrap justify-center sm:justify-start gap-x-4 gap-y-1">
                <span>&copy; 2026 Thalia SaaS. Tous droits réservés.</span>
                <span class="hidden sm:inline text-gray-200">|</span>
                <span class="inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Espace Multi-Tenant
                </span>
            </div>
            <div class="flex gap-4">
                <a href="#" class="hover:text-gray-600 transition">Mentions légales</a>
                <a href="#" class="hover:text-gray-600 transition">Confidentialité</a>
                <a href="#" class="hover:text-gray-600 transition">Support</a>
            </div>
        </div>
    </footer>

</body>
</html>