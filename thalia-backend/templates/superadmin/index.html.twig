{% extends 'base.html.twig' %}

{% block title %}Console d'Administration - Thalia{% endblock %}

{% block body %}
<div class="bg-slate-50 min-h-screen font-sans" x-data="{ activeTab: 'validation' }">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
        
        {# En-tête #}
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Console SuperAdmin</h1>
                <p class="text-sm text-slate-500 mt-1">Pilotage des validations, des établissements et des comptes utilisateurs.</p>
            </div>
        </div>

        {# Alerts Flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 rounded-xl border {% if label == 'success' %}bg-emerald-50 border-emerald-100 text-emerald-800{% else %}bg-rose-50 border-rose-100 text-rose-800{% endif %} text-sm shadow-xs flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full {% if label == 'success' %}bg-emerald-500{% else %}bg-rose-500{% endif %}"></span>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# ─── BARRE D'ONGLETS  ─── #}
        <div class="border-b border-slate-200">
            <nav class="-mb-px flex space-x-8 overflow-x-auto" aria-label="Tabs">
                <button type="button" @click="activeTab = 'validation'"
                    :class="activeTab === 'validation' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'"
                    class="whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm flex items-center gap-2 transition">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>À Valider</span>
                    {% if pendingUsersCount|default(0) + pendingOrganizationsCount|default(0) > 0 %}
                        <span class="bg-amber-100 text-amber-800 text-xs font-bold px-2 py-0.5 rounded-full">
                            {{ pendingUsersCount|default(0) + pendingOrganizationsCount|default(0) }}
                        </span>
                    {% endif %}
                </button>

                <button type="button" @click="activeTab = 'organizations'"
                    :class="activeTab === 'organizations' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'"
                    class="whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm flex items-center gap-2 transition">
                    <i class="fa-solid fa-building"></i>
                    <span>Établissements</span>
                </button>

                <button type="button" @click="activeTab = 'users'"
                    :class="activeTab === 'users' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'"
                    class="whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm flex items-center gap-2 transition">
                    <i class="fa-solid fa-users"></i>
                    <span>Utilisateurs</span>
                </button>
            </nav>
        </div>

        {# Rendu du composant Live Admin #}
        {{ component('admin_dashboard') }}

    </main>
</div>
{% endblock %}