{% extends 'base.html.twig' %}

{% block title %}{{ show.title }} - Thalia{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] text-slate-800 pb-16">

    {# ─── 1. BANDEAU DE COUVERTURE ─── #}
    <div class="relative w-full h-[300px] md:h-[360px] overflow-hidden shadow-md bg-slate-900 mb-8">
        {# Image de fond #}
        {% if show.artworkUrl %}
        <img src="{{ path('secure_show_image', {'id': show.id}) }}"
            class="absolute inset-0 w-full h-full object-cover opacity-40" alt="{{ show.title }}">
        {% else %}
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 opacity-80"></div>
        {% endif %}

        {# Overlay sombre progressif #}
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/30"></div>

        {# Contenu du bandeau #}
        <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col justify-between py-6">

            {# Haut du bandeau : Bouton Retour #}
            <div>
                <a href="{{ path('show_index') }}"
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white text-xs font-medium backdrop-blur-md transition border border-white/10">
                    <i class="fa-solid fa-arrow-left text-[11px]"></i>
                    <span>Retour à la liste</span>
                </a>
            </div>

            {# Bas du bandeau : Infos et Actions #}
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
                <div class="space-y-3 max-w-3xl">
                    {% if show.discipline %}
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500 text-white shadow-sm">
                        <i class="fa-solid fa-masks-theater text-[10px]"></i>
                        {{ show.discipline.value|capitalize }}
                    </span>
                    {% endif %}

                    {% if show.organization %}
                    <p class="text-slate-300 text-sm font-medium tracking-wide">{{ show.organization.name }}</p>
                    {% endif %}

                    <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
                        {{ show.title }}
                    </h1>
                </div>

                <div class="flex items-center gap-3 shrink-0">
                    {% if is_granted('SHOW_EDIT', show) %}
                    <a href="{{ path('show_edit', {'id': show.id}) }}"
                        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs shadow-sm transition">
                        <i class="fa-regular fa-pen-to-square text-indigo-600 text-sm"></i>
                        Modifier le spectacle
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        {# ─── 2. NAVIGATION PAR ONGLETS (TABS) ─── #}
        <div class="border-b border-slate-200 mb-8 overflow-x-auto scrollbar-none">

            <nav class="flex space-x-4 sm:space-x-8 text-sm font-bold min-w-max pb-1" id="show-tabs">
                <button type="button" data-tab="spectacle"
                    class="tab-btn border-b-2 border-sky-500 text-sky-600 pb-3 px-1 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-masks-theater"></i>
                    <span>Le spectacle</span>
                </button>

                <button type="button" data-tab="details"
                    class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 pb-3 px-1 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Détails</span>
                </button>

                <button type="button" data-tab="contacts"
                    class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 pb-3 px-1 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-address-book"></i>
                    <span>Contacts ({{ show.showContacts|length }})</span>
                </button>

                <button type="button" data-tab="medias"
                    class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 pb-3 px-1 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-folder-open"></i>
                    <span>Médias</span>
                </button>
            </nav>
        </div>

        {# ─── 3. CONTENU DES ONGLETS ─── #}

        {# ONGLET 1 : LE SPECTACLE (RÉÉQUILIBRÉ) #}
        <div id="tab-spectacle" class="tab-content space-y-6">

            {# Cartes de métadonnées rapide #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-sky-50 text-sky-600 rounded-lg shrink-0">
                        <i class="fa-solid fa-masks-theater text-lg"></i>
                    </div>
                    <div>
                        <span class="text-xs font-semibold text-slate-400 uppercase block">Discipline</span>
                        <span class="text-sm font-bold text-slate-800">{{ show.discipline ?
                            show.discipline.value|capitalize : 'Non renseigné' }}</span>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg shrink-0">
                        <i class="fa-regular fa-clock text-lg"></i>
                    </div>
                    <div>
                        <span class="text-xs font-semibold text-slate-400 uppercase block">Durée</span>
                        <span class="text-sm font-bold text-slate-800">{{ show.durationMin ? show.durationMin ~ '
                            minutes' : 'Non renseignée' }}</span>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg shrink-0">
                        <i class="fa-solid fa-users text-lg"></i>
                    </div>
                    <div>
                        <span class="text-xs font-semibold text-slate-400 uppercase block">Public</span>
                        <span class="text-sm font-bold text-slate-800">{{ show.audience ? show.audience.value : 'Tous
                            publics' }}</span>
                    </div>
                </div>
            </div>

            {# Disposition rééquilibrée : Grid 2 colonnes (Synopsis à gauche, Thèmes & Visuel à droite) #}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

                {# Colonne gauche : Synopsis (Prend 2 colonnes) #}
                <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-align-left text-sky-500"></i>
                        Synopsis
                    </h3>
                    {% if show.synopsis %}
                    <div
                        class="text-slate-700 text-sm leading-relaxed space-y-3 whitespace-pre-line border-t border-slate-100 pt-3">
                        {{ show.synopsis }}
                    </div>
                    {% else %}
                    <p class="text-slate-400 text-sm italic">Aucun synopsis n'a été renseigné pour ce spectacle.</p>
                    {% endif %}
                </div>

                {# Colonne droite : Thèmes & Carte latérale #}
                <div class="space-y-6">
                    {# Thèmes #}
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-3">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-tags text-indigo-500"></i>
                            Thèmes associés
                        </h3>
                        {% if show.themes is not empty %}
                        <div class="flex flex-wrap gap-2 pt-1">
                            {% for theme in show.themes %}
                            <span
                                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                <i class="fa-solid fa-tag text-[10px] text-slate-400 mr-1.5"></i>
                                {{ theme.name }}
                            </span>
                            {% endfor %}
                        </div>
                        {% else %}
                        <p class="text-slate-400 text-sm italic">Aucun thème associé.</p>
                        {% endif %}
                    </div>

                    {# Aperçu Affiche si présente #}
                    {% if show.artworkUrl %}
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 text-center space-y-3">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider text-left">Visuel principal
                        </h3>
                        <div class="rounded-xl overflow-hidden max-h-64 border border-slate-100 bg-slate-50">
                            <img src="{{ path('secure_show_image', {'id': show.id}) }}"
                                class="w-full h-full object-contain mx-auto" alt="{{ show.title }}">
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

        </div>

        {# ONGLET 2 : DÉTAILS DU SPECTACLE #}
        <div id="tab-details" class="tab-content hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {# Coût unitaire global #}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-2">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Coût unitaire global</h3>
                    <p class="text-3xl font-black text-slate-800">
                        {% if show.globalUnitCost %}
                        {{ show.globalUnitCost|number_format(2, ',', ' ') }} €
                        {% else %}
                        <span class="text-lg text-slate-400 font-normal italic">Non renseigné</span>
                        {% endif %}
                    </p>
                </div>

                {# Dimensions scène #}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-3">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Dimensions minimales de la
                        scène</h3>
                    <div class="grid grid-cols-3 gap-2 text-center pt-1">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <span class="block text-[11px] text-slate-400 font-semibold">Largeur</span>
                            <span class="text-base font-bold text-slate-800">{{ show.minStageWidth ? show.minStageWidth
                                ~ ' m' : '-' }}</span>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <span class="block text-[11px] text-slate-400 font-semibold">Profondeur</span>
                            <span class="text-base font-bold text-slate-800">{{ show.minStageDepth ? show.minStageDepth
                                ~ ' m' : '-' }}</span>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <span class="block text-[11px] text-slate-400 font-semibold">Hauteur</span>
                            <span class="text-base font-bold text-slate-800">{{ show.minStageHeight ?
                                show.minStageHeight ~ ' m' : '-' }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Informations Artistiques #}
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-3">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Informations artistiques</h3>
                {% if show.artisticInformation %}
                <p class="text-slate-700 text-sm leading-relaxed whitespace-pre-line">{{ show.artisticInformation }}</p>
                {% else %}
                <p class="text-slate-400 text-sm italic">Aucune information artistique renseignée.</p>
                {% endif %}
            </div>

            {# Informations Techniques #}
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-3">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Informations techniques</h3>
                {% if show.technicalInformation %}
                <p class="text-slate-700 text-sm leading-relaxed whitespace-pre-line">{{ show.technicalInformation }}
                </p>
                {% else %}
                <p class="text-slate-400 text-sm italic">Aucune fiche ou information technique renseignée.</p>
                {% endif %}
            </div>

            {# Dates de suivi #}
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500">
                    <div>
                        <span class="font-semibold text-slate-700">Créé le :</span>
                        {{ show.createdAt ? show.createdAt|date('d/m/Y à H:i') : '-' }}
                    </div>
                    <div>
                        <span class="font-semibold text-slate-700">Dernière modification :</span>
                        {{ show.updatedAt ? show.updatedAt|date('d/m/Y à H:i') : '-' }}
                    </div>
                </div>
            </div>
        </div>

        {# ONGLET 3 : LES CONTACTS #}
        {# ONGLET 3 : LES CONTACTS #}
        <div id="tab-contacts" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Contacts rattachés</h3>

                {% if show.showContacts is not empty %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for showContact in show.showContacts %}
                    {# On extrait l'objet Contact réel relié à la relation ShowContact #}
                    {% set contact = showContact.contact %}

                    <div
                        class="relative group p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-slate-300 hover:shadow-md transition-all duration-200 flex flex-col justify-between space-y-3">

                        {# Lien vers la fiche du contact #}
                        {% if contact %}
                        <a href="{{ path('contact_show', {'id': contact.id}) }}" class="absolute inset-0 z-0 rounded-xl"
                            title="Voir la fiche contact"></a>
                        {% endif %}

                        {# En-tête : Avatar + Nom #}
                        <div class="flex items-center gap-3 relative z-10 pointer-events-none">
                            <div
                                class="w-10 h-10 rounded-full bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-sm shrink-0 group-hover:bg-sky-500 group-hover:text-white transition-colors">
                                <i class="fa-regular fa-user"></i>
                            </div>
                            <div class="truncate">
                                <h4
                                    class="text-sm font-bold text-slate-800 group-hover:text-sky-600 transition-colors truncate">
                                    {% if contact %}
                                    {{ contact.firstName }} {{ contact.lastName }}
                                    {% else %}
                                    <span class="italic text-slate-400">Contact inconnu</span>
                                    {% endif %}
                                </h4>
                                {% if contact and contact.role is defined and contact.role %}
                                <p class="text-xs text-slate-400 truncate">{{ contact.role }}</p>
                                {% endif %}
                            </div>
                        </div>

                        {# Note/Rapport éventuel lié à la relation #}
                        {% if showContact.report is defined and showContact.report %}
                        <div
                            class="relative z-10 p-2.5 rounded-lg bg-indigo-50/60 border border-indigo-100/80 text-[11px] text-slate-600 space-y-1">
                            <p class="line-clamp-3 italic">{{ showContact.report }}</p>
                        </div>
                        {% endif %}

                        {# Pied : Email & Téléphone #}
                        {% if contact %}
                        <div class="pt-2 border-t border-slate-200/60 space-y-1 text-xs text-slate-600 relative z-10">
                            {% if contact.email %}
                            <a href="mailto:{{ contact.email }}"
                                class="flex items-center gap-2 hover:text-sky-600 transition truncate w-max max-w-full">
                                <i class="fa-regular fa-envelope text-slate-400 w-4"></i>
                                {{ contact.email }}
                            </a>
                            {% endif %}
                            {% if contact.phone %}
                            <a href="tel:{{ contact.phone }}"
                                class="flex items-center gap-2 hover:text-sky-600 transition w-max max-w-full">
                                <i class="fa-solid fa-phone text-slate-400 w-4"></i>
                                {{ contact.phone }}
                            </a>
                            {% endif %}
                        </div>
                        {% endif %}

                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-slate-400 text-sm italic">Aucun contact associé à ce spectacle.</p>
                {% endif %}
            </div>
        </div>
        {# ONGLET 4 : LES MÉDIAS #}
        <div id="tab-medias" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Documents et médias du spectacle
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {# Visual / Image du spectacle #}
                    <div class="p-4 rounded-xl border border-slate-200 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg">
                                <i class="fa-regular fa-image text-xl"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-800">Affiche / Visuel</h4>
                                <p class="text-xs text-slate-400">Image principale du spectacle</p>
                            </div>
                        </div>
                        {% if show.artworkUrl %}
                        <a href="{{ path('secure_show_image', {'id': show.id}) }}" target="_blank"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition">
                            <i class="fa-solid fa-download"></i>
                            Voir / Télécharger
                        </a>
                        {% else %}
                        <span class="text-xs text-slate-400 italic">Aucune image</span>
                        {% endif %}
                    </div>

                    {# Dossier artistique (PDF) #}
                    <div class="p-4 rounded-xl border border-slate-200 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="p-3 bg-rose-50 text-rose-600 rounded-lg">
                                <i class="fa-solid fa-file-pdf text-xl"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-800">Dossier artistique</h4>
                                <p class="text-xs text-slate-400">Document PDF complémentaire</p>
                            </div>
                        </div>
                        {% if show.artisticFile %}
                        <a href="{{ path('secure_show_pdf' , {'id': show.id}) }}" target="_blank"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition">
                            <i class="fa-solid fa-download"></i>
                            Télécharger
                        </a>
                        {% else %}
                        <span class="text-xs text-slate-400 italic">Aucun fichier PDF</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}