{% extends 'base.html.twig' %}

{% block title %}Thalia - Nouveau spectacle{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card modal-card-lg">
        
        {# Bouton de fermeture pour retourner à la liste #}
        <a href="{{ path('show_index') }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        {# En-tête de la modale #}
        <div class="text-center mb-6">
            <nav class="text-xs text-gray-400 font-medium mb-1 flex items-center justify-center gap-2">
                <span>Spectacles</span>
                <i class="fa-solid fa-chevron-right text-[9px]"></i>
                <span class="text-indigo-500 font-semibold">Nouveau</span>
            </nav>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Ajouter un spectacle</h1>
            <p class="text-xs text-slate-500 mt-1">Renseignez les détails pour intégrer une nouvelle création au catalogue.</p>
        </div>

        {# Formulaire #}
        {{ include('show/_form.html.twig', {'button_label': 'Passer à la suite'}) }}
        
    </div>
</div>
{% endblock %}