{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

{# ─── ALERTE GLOBALE EN HAUT SI ERREURS ─── #}
{% if not form.vars.valid %}
<div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs shadow-sm">
    <div class="flex items-center gap-2 font-bold mb-1 text-rose-700">
        <i class="fa-solid fa-triangle-exclamation text-sm"></i>
        <span>Des erreurs sont survenues dans le formulaire :</span>
    </div>
    <ul class="list-disc list-inside space-y-0.5 text-rose-700 font-medium">
        {{ form_errors(form) }}
        {% for child in form.children %}
        {% for error in child.vars.errors %}
        <li>
            <strong>{{ child.vars.label|default(child.vars.name) }} :</strong> {{ error.message }}
        </li>
        {% endfor %}
        {% endfor %}
    </ul>
</div>
{% endif %}

<div class="form-card">

    {# ─── 1. TITRE ET INFORMATIONS GÉNÉRALES ─── #}
    <div class="border-b border-gray-100 pb-6 space-y-4">
        <h2 class="form-section-title">
            Informations Générales
        </h2>

        <div class="form-group {% if not form.title.vars.valid %}has-error{% endif %}">
            {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <div class="form-group {% if not form.pipeline_status.vars.valid %}has-error{% endif %}">
                {{ form_label(form.pipeline_status, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.pipeline_status, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.pipeline_status) }}
            </div>
            <div class="form-group {% if not form.discipline.vars.valid %}has-error{% endif %}">
                {{ form_label(form.discipline, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.discipline, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.discipline) }}
            </div>
            <div class="form-group {% if not form.audience.vars.valid %}has-error{% endif %}">
                {{ form_label(form.audience, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.audience, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.audience) }}
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-4 py-4 border-b border-gray-100">
        <div class="form-group {% if not form.duration_min.vars.valid %}has-error{% endif %}">
            {{ form_label(form.duration_min, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.duration_min, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.duration_min) }}
        </div>
        <div class="form-group {% if not form.global_unit_cost.vars.valid %}has-error{% endif %}">
            {{ form_label(form.global_unit_cost, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.global_unit_cost, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.global_unit_cost) }}
        </div>
    </div>

    {# ─── 2. PRÉSENTATION & CONTENU ARTISTIQUE ─── #}
    <div class="border-b border-gray-100 py-6 space-y-4">
        <h2 class="form-section-title">
            Présentation & Contenu
        </h2>

        <div class="form-group {% if not form.synopsis.vars.valid %}has-error{% endif %}">
            {{ form_label(form.synopsis, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.synopsis, {'attr': {'class': 'form-input', 'rows': '3'}}) }}
            {{ form_errors(form.synopsis) }}
        </div>

        <div class="form-group {% if not form.themes.vars.valid %}has-error{% endif %}">
            {{ form_label(form.themes, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.themes, {'attr': {'class': 'tom-select form-input py-2'}}) }}
            <p class="form-help-text">Maintenez Ctrl (ou Cmd sur Mac) appuyé pour sélectionner plusieurs thèmes.</p>
            {{ form_errors(form.themes) }}
        </div>

        <div class="form-group {% if not form.artistic_information.vars.valid %}has-error{% endif %}">
            {{ form_label(form.artistic_information, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.artistic_information, {'attr': {'class': 'form-input', 'rows': '3'}}) }}
            {{ form_errors(form.artistic_information) }}
        </div>
    </div>

    {# ─── 3. DONNÉES TECHNIQUES ─── #}
    <div class="border-b border-gray-100 py-6 space-y-4">
        <h2 class="form-section-title">
            Données Techniques
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="form-group {% if not form.min_stage_width.vars.valid %}has-error{% endif %}">
                {{ form_label(form.min_stage_width, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.min_stage_width, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.min_stage_width) }}
            </div>
            <div class="form-group {% if not form.min_stage_depth.vars.valid %}has-error{% endif %}">
                {{ form_label(form.min_stage_depth, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.min_stage_depth, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.min_stage_depth) }}
            </div>
            <div class="form-group {% if not form.min_stage_height.vars.valid %}has-error{% endif %}">
                {{ form_label(form.min_stage_height, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.min_stage_height, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.min_stage_height) }}
            </div>
        </div>

        <div class="form-group {% if not form.technical_information.vars.valid %}has-error{% endif %}">
            {{ form_label(form.technical_information, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.technical_information, {'attr': {'class': 'form-input', 'rows': '3'}}) }}
            {{ form_errors(form.technical_information) }}
        </div>
    </div>

    {# ─── 4. MÉDIAS ET DOCUMENTS ATTACHÉS ─── #}
    <div class="pt-6 space-y-4">
        <h2 class="form-section-title">
            Fichiers & Visuels
        </h2>

        {# 🖼️ Affiche du spectacle #}
        <div class="form-group {% if not form.artworkUrl.vars.valid %}has-error{% endif %}">
            {{ form_label(form.artworkUrl, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="form-file-box">
                <div class="form-file-preview w-16 h-16 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shrink-0">
                    {% if show is defined and show.id and show.artworkUrl %}
                        <img id="artwork-preview-img" src="{{ path('secure_show_image', {'id': show.id}) }}" class="w-full h-full object-cover" alt="Affiche actuelle">
                        <i id="artwork-preview-icon" class="fa-regular fa-image text-xl hidden"></i>
                    {% else %}
                        <i id="artwork-preview-icon" class="fa-regular fa-image text-xl text-slate-400"></i>
                        <img id="artwork-preview-img" src="" class="w-full h-full object-cover hidden" alt="Prévisualisation">
                    {% endif %}
                </div>
                <div class="grow w-full">
                    {{ form_widget(form.artworkUrl, {
                        'attr': {
                            'class': 'form-input-sm',
                            'accept': 'image/jpeg,image/png,image/webp',
                            'onchange': "handleImagePreview(this, 'artwork-preview-img', 'artwork-preview-icon')"
                        }
                    }) }}
                    <p class="form-help-text">Format JPG, PNG ou WebP - Max 1 Mo.</p>
                </div>
            </div>
            {{ form_errors(form.artworkUrl) }}
        </div>

        {# 📄 Documentation PDF #}
        <div class="form-group {% if not form.artistic_file.vars.valid %}has-error{% endif %}">
            {{ form_label(form.artistic_file, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="form-file-box">
                <div class="form-file-preview w-12 h-12 rounded-lg bg-red-50 text-red-500 border border-red-100 flex items-center justify-center shrink-0">
                    <i class="fa-regular fa-file-pdf text-2xl"></i>
                </div>

                <div class="grow w-full space-y-1">
                    {{ form_widget(form.artistic_file, {
                        'attr': {
                            'class': 'form-input-sm',
                            'accept': 'application/pdf',
                            'onchange': "handleDocumentPreview(this, 'pdf-file-info')"
                        }
                    }) }}

                    {# Zone d'information dynamique pour le document #}
                    <div id="pdf-file-info" class="flex items-center gap-2 text-xs text-gray-600 mt-1">
                        {% if show is defined and show.id and show.artisticFile %}
                            <span class="font-medium text-emerald-600">
                                <i class="fa-solid fa-circle-check text-emerald-500"></i> Document actuel :
                            </span>
                            <a href="{{ path('secure_show_pdf', {'id': show.id}) }}" target="_blank" class="font-semibold text-indigo-600 hover:text-indigo-800 underline inline-flex items-center gap-1">
                                <i class="fa-solid fa-download text-[10px]"></i> {{ show.artisticFile }}
                            </a>
                        {% else %}
                            <p class="form-help-text">Format PDF uniquement - Max 40 Mo.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            {{ form_errors(form.artistic_file) }}
        </div>
    </div>

    {# ─── ACTIONS ─── #}
    <div class="form-actions mt-6">
        <a href="{{ path('show_index') }}" class="btn-cancel">
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            {{ button_label|default('Enregistrer') }} <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </button>
    </div>

</div>

{{ form_rest(form) }}
{{ form_end(form) }}