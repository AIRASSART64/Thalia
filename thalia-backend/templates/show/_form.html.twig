{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

<div class="form-card">

    {# ─── 1. TITRE ET INFORMATIONS GÉNÉRALES ─── #}
    <div class="border-b border-gray-100 pb-6 space-y-4">
        <h2 class="form-section-title">
            Informations Générales
        </h2>

        <div>
            {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <div>
                {{ form_label(form.pipeline_status, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.pipeline_status, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.pipeline_status) }}
            </div>
            <div>
                {{ form_label(form.discipline, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.discipline, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.discipline) }}
            </div>
            <div>
                {{ form_label(form.audience, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.audience, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.audience) }}
            </div>

        </div>
    </div>

     <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-4">
          
            <div>
                {{ form_label(form.duration_min, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.duration_min, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.duration_min) }}
            </div>
            <div>
                {{ form_label(form.global_unit_cost, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.global_unit_cost, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.global_unit_cost) }}
            </div>
    </div>
    

    {# ─── 2. PRÉSENTATION & CONTENU ARTISTIQUE ─── #}
    <div class="border-b border-gray-100 pb-6 space-y-4">
        <h2 class="form-section-title">
            Présentation & Contenu
        </h2>

        <div>
            {{ form_label(form.synopsis, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.synopsis, {'attr': {'class': 'form-input', 'rows': '3'}}) }}
            {{ form_errors(form.synopsis) }}
        </div>

        <div>
            {{ form_label(form.themes, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.themes, {'attr': {'class': 'tom-select form-input py-2'}}) }}
            <p class="form-help-text">Maintenez Ctrl (ou Cmd sur Mac) appuyé pour sélectionner plusieurs thèmes.</p>
            {{ form_errors(form.themes) }}
        </div>

        <div>
            {{ form_label(form.artistic_information, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.artistic_information, {'attr': {'class': 'form-input', 'rows': '3'}}) }}
            {{ form_errors(form.artistic_information) }}
        </div>
    </div>

    {# ─── 3. DONNÉES TECHNIQUES ─── #}
    <div class="border-b border-gray-100 pb-6 space-y-4">
        <h2 class="form-section-title">
            Données Techniques
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                {{ form_label(form.min_stage_width, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.min_stage_width, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.min_stage_width) }}
            </div>
            <div>
                {{ form_label(form.min_stage_depth, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.min_stage_depth, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.min_stage_depth) }}
            </div>
            <div>
                {{ form_label(form.min_stage_height, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.min_stage_height, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.min_stage_height) }}
            </div>
        </div>

        <div>
            {{ form_label(form.technical_information, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.technical_information, {'attr': {'class': 'form-input', 'rows': '3'}}) }}
            {{ form_errors(form.technical_information) }}
        </div>
    </div>

    {# ─── 4. MÉDIAS ET DOCUMENTS ATTACHÉS ─── #}
    <div class="space-y-4">
        <h2 class="form-section-title">
            Fichiers & Visuels
        </h2>

        {# Affiche de spectacle #}
        <div>
            {{ form_label(form.artworkUrl, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="form-file-box">
                {% if show is defined and show.id and show.artworkUrl %}
                    <div class="form-file-preview">
                        <img src="{{ path('secure_show_image', {'id': show.id}) }}" class="w-full h-full object-cover" alt="Affiche actuelle">
                    </div>
                {% else %}
                    <div class="form-file-preview">
                        <i class="fa-regular fa-image text-xl"></i>
                    </div>
                {% endif %}
                <div class="grow w-full">
                    {{ form_widget(form.artworkUrl, {'attr': {'class': 'form-input-sm'}}) }}
                    <p class="form-help-text">Format JPG, PNG ou WebP - Max 1 Mo.</p>
                </div>
            </div>
            {{ form_errors(form.artworkUrl) }}
        </div>

        {# Documentation PDF #}
        <div>
            {{ form_label(form.artistic_file, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="form-file-box">
                {% if show is defined and show.id and show.artisticFile %}
                    <div class="form-file-preview bg-red-50 text-red-500 border-red-100">
                        <i class="fa-regular fa-file-pdf text-2xl"></i>
                    </div>
                {% else %}
                    <div class="form-file-preview">
                        <i class="fa-regular fa-file-pdf text-xl"></i>
                    </div>
                {% endif %}
                <div class="grow w-full">
                    {{ form_widget(form.artistic_file, {'attr': {'class': 'form-input-sm'}}) }}
                    <p class="form-help-text">Format PDF uniquement - Max 4 Mo.</p>
                </div>
            </div>
            {{ form_errors(form.artistic_file) }}
        </div>
    </div>

    {# ─── ACTIONS ─── #}
    <div class="form-actions">
        <a href="{{ path('show_index') }}" class="btn-cancel">
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            {{ button_label|default('Enregistrer') }} <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </button>
    </div>

</div>

{{ form_rest(form) }}
{{ form_end(form) }}