{% extends 'base.html.twig' %}

{% block title %}Thalia - Modifier {{ show.title }}{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card modal-card-lg">
        
        <a href="{{ path('show_index') }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        <div class="text-center mb-6">
            <nav class="text-xs text-gray-400 font-medium mb-1 flex items-center justify-center gap-2">
                <span>Spectacles</span>
                <i class="fa-solid fa-chevron-right text-[9px]"></i>
                <span class="text-indigo-500 font-semibold">Édition</span>
            </nav>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Modifier le spectacle</h1>
            <p class="text-xs text-indigo-600 font-medium mt-1">{{ show.title }}</p>
        </div>

        {{ include('show/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
        
    </div>
</div>
{% endblock %}