{% extends 'base.html.twig' %}

{% block title %}Mon Profil & Paramètres - Thalia{% endblock %}

{% block body %}
<div class="flex min-h-[calc(100vh-4rem)] bg-slate-50/50 font-sans">

    {% include "components/_sidebar.html.twig" %}

    {# Contenu principal #}
    <div class="grow p-4 sm:p-8 max-w-6xl mx-auto w-full">
        
        {# En-tête de la page #}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">MON ESPACE</h1>
                <p class="text-sm text-slate-400 mt-0.5">Gérez votre profil, vos identifiants et vos préférences de compte.</p>
            </div>
        </div>

        <div class="space-y-6">
            
            {# CARD 1 : Profil & Avatar #}
            <div class="card-thalia overflow-hidden relative">
                <div class="h-20 bg-linear-to-r from-indigo-100 via-indigo-50/50 to-slate-50"></div>
                
                <div class="p-6 pt-0 flex flex-col sm:flex-row items-start sm:items-center gap-5 relative">
                    
                    {# Formulaire d'upload photo d'identité / Avatar #}
                    <form action="#" method="POST" enctype="multipart/form-data" id="avatar-form" class="relative group shrink-0 -mt-10">
                        <div class="w-24 h-24 rounded-2xl bg-slate-100 border-4 border-white shadow-md flex items-center justify-center text-slate-400 font-bold text-2xl overflow-hidden relative">
                            {% if app.user and app.user.avatarUrl is defined and app.user.avatarUrl %}
                                <img id="avatar-preview" src="{{ app.user.avatarUrl }}" alt="Avatar" class="w-full h-full object-cover">
                            {% else %}
                                <i id="avatar-icon" class="fa-regular fa-user text-3xl"></i>
                                <img id="avatar-preview" src="" alt="Avatar" class="w-full h-full object-cover hidden">
                            {% endif %}
                            
                            {# Overlay d'upload au survol #}
                            <label for="avatar-input" class="absolute inset-0 bg-indigo-900/60 text-white flex flex-col items-center justify-center gap-1 opacity-0 group-hover:opacity-100 transition cursor-pointer">
                                <i class="fa-solid fa-camera text-sm"></i>
                                <span class="text-[10px] font-semibold">Changer</span>
                            </label>
                        </div>
                        <input type="file" id="avatar-input" name="avatar" class="hidden" accept="image/*"">
                    </form>
                    
                    {# Informations utilisateur & Rôle #}
                    <div class="grow sm:pt-4">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="text-xl font-bold text-slate-900">
                                {{ app.user.firstName ?? 'Jean-Baptiste' }} {{ app.user.lastName ?? 'Poquelin' }}
                            </h2>

                            {# Badges de Rôles #}
                            {% if app.user %}
                                {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
                                    <span class="inline-flex items-center gap-1 text-[10px] bg-red-50 text-red-700 border border-red-100 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">
                                        <i class="fa-solid fa-shield-halved text-[9px]"></i> Super Admin
                                    </span>
                                {% elseif 'ROLE_ADMIN' in app.user.roles %}
                                    <span class="inline-flex items-center gap-1 text-[10px] bg-indigo-50 text-indigo-700 border border-indigo-100 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">
                                        <i class="fa-solid fa-user-gear text-[9px]"></i> Admin SaaS
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 text-[10px] bg-slate-100 text-slate-600 border border-slate-200 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">
                                        <i class="fa-regular fa-user text-[9px]"></i> Membre
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="inline-flex items-center gap-1 text-[10px] bg-indigo-50 text-indigo-700 border border-indigo-100 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">
                                    Admin SaaS
                                </span>
                            {% endif %}
                        </div>
                        <p class="text-xs text-slate-400 mt-1">{{ app.user.email ?? 'thalia.admin@example.com' }}</p>
                    </div>

                </div>
            </div>

            {# CARD 2 : Sécurité du compte #}
            <div class="card-thalia p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm shrink-0">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Sécurité & Identifiants</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Mettez à jour votre mot de passe et sécurisez votre accès.</p>
                    </div>
                </div>
                <a href="{{ path('profile_password_edit') }}" class="btn-indigo text-xs">
                    <i class="fa-solid fa-key mr-1"></i> Changer le mot de passe
                </a>
            </div>

            {# CARD 3 : Préférences système #}
            <div class="card-thalia p-6 space-y-4">
                <div class="flex items-center gap-2 text-slate-900 font-bold border-b border-slate-100 pb-3">
                    <i class="fa-solid fa-sliders text-indigo-600"></i>
                    <h3>Préférences système</h3>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-3 bg-slate-50/50 rounded-xl border border-slate-100">
                    <div>
                        <h4 class="text-sm font-bold text-slate-800">Thème visuel</h4>
                        <p class="text-xs text-slate-400 mt-0.5">Personnalisez l'affichage de votre interface</p>
                    </div>
                    <div class="flex bg-slate-200/60 p-1 rounded-lg text-slate-500 text-xs font-medium">
                        <button type="button" class="bg-white text-slate-900 px-3 py-1 rounded-md shadow-sm inline-flex items-center gap-1.5 font-semibold">
                            <i class="fa-regular fa-sun text-amber-500 text-[11px]"></i> Clair
                        </button>
                        <button type="button" class="px-3 py-1 inline-flex items-center gap-1.5 hover:text-slate-800 transition">
                            <i class="fa-regular fa-moon text-[11px]"></i> Sombre
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{% endblock %}