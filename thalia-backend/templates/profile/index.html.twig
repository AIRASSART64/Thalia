{% extends 'base.html.twig' %}

{% block title %}Mon Profil & Paramètres - Thalia{% endblock %}

{% block body %}
<div class="flex min-h-[calc(100vh-4rem)] bg-slate-50/50 font-sans">

    {% include "components/_sidebar.html.twig" %}

    {# Contenu principal #}
    <div class="grow p-4 sm:p-8 max-w-6xl mx-auto w-full">

        {# En-tête de la page #}
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">MON ESPACE</h1>
            <p class="text-sm text-slate-500 mt-1">Gérez vos informations personnelles et la sécurité de votre compte.</p>
        </div>

        {# GRILLE PRINCIPALE #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            {# ─── COLONNE GAUCHE (1/3) : Carte d'identité synthétique ─── #}
            <div class="lg:col-span-1">
                <div class="card-thalia p-6 flex flex-col items-center text-center relative overflow-hidden bg-white rounded-2xl border border-slate-200/80 shadow-sm">
                    
                    {# Décoration de fond - Couleur de marque Thalia (Violet / Indigo) #}
                    <div class="absolute top-0 inset-x-0 h-24 bg-gradient-to-r from-violet-600 via-indigo-600 to-violet-700 opacity-90"></div>

                    {# Avatar avec bordure blanche #}
                    <div class="relative z-10 mt-6 mb-4">
                        <div class="w-28 h-28 rounded-2xl bg-slate-100 border-4 border-white shadow-lg flex items-center justify-center text-slate-400 overflow-hidden">
                            {% if user.avatarFilename %}
                                <img src="{{ path('secure_profile', {'id': user.id}) }}" alt="Avatar de {{ user.firstName }}" class="w-full h-full object-cover">
                            {% else %}
                                <i class="fa-regular fa-user text-4xl"></i>
                            {% endif %}
                        </div>
                    </div>

                    {# Nom, Prénom & Email #}
                    <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">
                        {{ user.firstName }} {{ user.lastName }}
                    </h2>
                    <p class="text-xs text-slate-400 font-medium mt-0.5 mb-3">{{ user.email }}</p>

                    {# Badge de rôle principal #}
                    <div class="mb-6">
                        {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                            <span class="inline-flex items-center gap-1.5 text-xs bg-rose-50 text-rose-700 border border-rose-200/60 px-3 py-1 rounded-full font-bold uppercase tracking-wider">
                                <i class="fa-solid fa-shield-halved text-xs"></i> Super Admin
                            </span>
                        {% elseif 'ROLE_ADMIN' in user.roles %}
                            <span class="inline-flex items-center gap-1.5 text-xs bg-violet-50 text-violet-700 border border-violet-200/60 px-3 py-1 rounded-full font-bold uppercase tracking-wider">
                                <i class="fa-solid fa-user-gear text-xs"></i> Admin SaaS
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 text-xs bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1 rounded-full font-bold uppercase tracking-wider">
                                <i class="fa-regular fa-user text-xs"></i> {{ userRoles|first|default('Utilisateur') }}
                            </span>
                        {% endif %}
                    </div>

                    {# Bouton modifier profil (Aux couleurs Thalia) #}
                    <a href="{{ path('profile_edit') }}" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-violet-600 hover:bg-violet-700 text-white font-semibold text-xs rounded-xl shadow-xs transition-colors">
                        <i class="fa-solid fa-user-pen"></i> Modifier mes informations
                    </a>
                </div>
            </div>

            {# ─── COLONNE DROITE (2/3) : Détails des données & Sécurité ─── #}
            <div class="lg:col-span-2 space-y-6">

                {# CARD 1 : Détails du Profil #}
                <div class="card-thalia p-6 space-y-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-violet-50 text-violet-600 flex items-center justify-center text-sm">
                                <i class="fa-regular fa-id-card"></i>
                            </div>
                            <h3 class="text-base font-bold text-slate-900">Informations personnelles</h3>
                        </div>
                    </div>

                    {# Grille des informations #}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        
                        {# Prénom #}
                        <div class="p-3.5 rounded-xl bg-slate-50/70 border border-slate-100 space-y-1">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 block">Prénom</span>
                            <p class="text-sm font-bold text-slate-800">{{ user.firstName }}</p>
                        </div>

                        {# Nom #}
                        <div class="p-3.5 rounded-xl bg-slate-50/70 border border-slate-100 space-y-1">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 block">Nom</span>
                            <p class="text-sm font-bold text-slate-800">{{ user.lastName }}</p>
                        </div>

                        {# Adresse E-mail (VERROUILLÉE / NON MODIFIABLE) #}
                        <div class="p-3.5 rounded-xl bg-slate-100/80 border border-slate-200/80 space-y-1 sm:col-span-2 cursor-not-allowed">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 block">Adresse E-mail</span>
                                <span class="inline-flex items-center gap-1 text-[10px] font-medium text-slate-500 bg-slate-200/70 px-2 py-0.5 rounded-md">
                                    <i class="fa-solid fa-lock text-[9px]"></i> Non modifiable
                                </span>
                            </div>
                            <div class="flex items-center gap-2 text-sm font-bold text-slate-600">
                                <i class="fa-regular fa-envelope text-slate-400"></i>
                                <span>{{ user.email }}</span>
                            </div>
                        </div>

                    </div>
                </div>

                {# CARD 2 : Sécurité & Mot de passe #}
                <div class="card-thalia p-6 space-y-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-slate-900">Sécurité du compte</h3>
                                <p class="text-xs text-slate-400">Gérez l'accès et votre mot de passe</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-slate-800">Mot de passe</span>
                                <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded">
                                    <i class="fa-solid fa-check text-[9px]"></i> Protégé
                                </span>
                            </div>
                            <p class="text-xs text-slate-400">Il est recommandé de changer régulièrement votre mot de passe.</p>
                        </div>

                        <a href="{{ path('password_edit') }}" class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-xl transition-colors shrink-0 whitespace-nowrap">
                            <i class="fa-solid fa-key text-[11px]"></i> Modifier le mot de passe
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
{% endblock %}