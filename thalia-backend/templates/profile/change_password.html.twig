{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe - Thalia{% endblock %}

{% block body %}
<div class="modal-backdrop">
    <div class="modal-card">
        
        {# Bouton fermer (Croix) #}
        <a href="{{ path('profile_index') }}" class="modal-close-btn" title="Fermer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </a>

        <div class="text-center mb-6">
            <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Modifier le mot de passe</h1>
            <p class="form-help-text mt-1">Pour sécuriser votre accès, choisissez un mot de passe robuste.</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}
            
            {# 1. Mot de passe actuel #}
            <div class="form-group {{ form.currentPassword.vars.errors|length > 0 ? 'has-error' : '' }}">
                {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.currentPassword, {'attr': {'class': 'form-input', 'placeholder': '••••••••'}}) }}
                {{ form_errors(form.currentPassword) }}
            </div>

            {# 2. Nouveau mot de passe (sans confirmation) #}
            <div class="form-group {{ form.newPassword.vars.errors|length > 0 ? 'has-error' : '' }}">
                {{ form_label(form.newPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.newPassword, {'attr': {'class': 'form-input', 'placeholder': '••••••••'}}) }}
                {{ form_errors(form.newPassword) }}
            </div>

            {# Actions #}
            <div class="form-actions pt-4">
                <a href="{{ path('profile_index') }}" class="btn-cancel">
                    Annuler
                </a>
                <button type="submit" class="btn-submit">
                    <i class="fa-solid fa-key"></i>
                    <span>Mettre à jour</span>
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}